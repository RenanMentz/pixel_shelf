<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/preto"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="Voltar"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Novo jogo" />

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp"
            android:paddingTop="8dp" android:paddingBottom="32dp">

            <!-- Importar da Steam (só ao cadastrar) -->
            <LinearLayout
                android:id="@+id/secaoSteam"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_cartao"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Preencher automaticamente"
                    android:textAppearance="@style/PixelShelf.Texto.Rotulo" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Busque o jogo na Steam para trazer capa, informações e conquistas."
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuscarSteam"
                    style="@style/PixelShelf.Botao.Contorno"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Buscar na Steam"
                    app:icon="@drawable/ic_busca" />
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressoSteam"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:trackThickness="3dp" />
                <TextView
                    android:id="@+id/tvSteam"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Capa -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivCapa"
                    android:layout_width="104dp" android:layout_height="156dp"
                    android:background="@color/superficie_2"
                    android:contentDescription="Capa do jogo"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/PixelShelf.Forma.Capa" />
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" android:layout_weight="1"
                    android:orientation="vertical">
                    <Button
                        android:id="@+id/btnEscolherCapa"
                        style="@style/PixelShelf.Botao.Contorno"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Escolher capa" />
                    <Button
                        android:id="@+id/btnRemoverCapa"
                        style="@style/PixelShelf.Botao.Texto"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Remover capa" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTitulo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:hint="Título *"
                app:counterEnabled="true" app:counterMaxLength="100">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTitulo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapWords" android:maxLength="100" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPlataforma"
                style="@style/PixelShelf.Campo.Lista"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:hint="Plataforma *">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/acPlataforma"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStatus"
                style="@style/PixelShelf.Campo.Lista"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="Status *">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/acStatus"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNota"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" android:layout_weight="1"
                    android:hint="Nota (0 a 10)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNota"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilHoras"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_weight="1"
                    android:hint="Horas jogadas *">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHoras"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLancamento"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="Data de lançamento"
                app:endIconContentDescription="Limpar data"
                app:endIconDrawable="@drawable/ic_fechar"
                app:endIconMode="custom">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLancamento"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDesenvolvedora"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="Desenvolvedora">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDesenvolvedora"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilGenero"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="Gênero">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGenero"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescricao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="Descrição">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescricao"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:text="Salvar" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
