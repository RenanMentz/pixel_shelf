<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp" android:layout_marginVertical="4dp"
    android:background="@drawable/bg_item_conquista"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivImagem"
        android:layout_width="104dp" android:layout_height="39dp"
        android:background="@color/superficie_3"
        android:contentDescription="Imagem do jogo"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/PixelShelf.Forma.Icone" />

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvNome"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/texto"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tvDetalhe"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbSelecionado"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />
</LinearLayout>
